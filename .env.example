# ---------------------------------------------------------------
# OpenRouter — https://openrouter.ai/keys
# ---------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo do agente. Alternativas:
#   anthropic/claude-sonnet-5     (melhor raciocinio culinario)
#   anthropic/claude-haiku-4.5    (mais rapido e barato)
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Opcional — aparecem no ranking do OpenRouter
OPENROUTER_APP_URL=http://localhost:8501
OPENROUTER_APP_NAME=Chef Library

# ---------------------------------------------------------------
# Embeddings — via OpenRouter /v1/embeddings (mesma key acima).
# Trocado de local (sentence-transformers) para a API porque em Macs com
# pouca RAM a inferencia local levava ~4h para o acervo inteiro; a API
# entrega o mesmo em ~20min por menos de US$ 1.
# ---------------------------------------------------------------
EMBED_MODEL=openai/text-embedding-3-small
EMBED_BATCH_SIZE=500

# ---------------------------------------------------------------
# Caminhos
# ---------------------------------------------------------------
BOOKS_RAW_DIR=books
BOOKS_CLEAN_DIR=books_md
INDEX_DIR=data/index
