# ---------------------------------------------------------------
# Provedor do AGENTE (quem responde a pergunta) — o primeiro destes 4 com
# key configurada vence, nesta ordem: OpenRouter > OpenAI > Anthropic >
# Ollama local (sem nenhuma key, roda de graca num modelo local pequeno).
# Ver backend/core/providers.py.
# ---------------------------------------------------------------

# 1) OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   anthropic/claude-sonnet-5     (melhor raciocinio culinario)
#   anthropic/claude-haiku-4.5    (mais rapido e barato, segue bem o escopo)
#   openai/gpt-5-nano             (mais barato ainda, mas e "reasoning" —
#                                   precisa de reasoning:effort=minimal pra
#                                   nao devolver vazio — e ignora a regra de
#                                   recusar pergunta fora do tema; testado)
#   openai/gpt-4o-mini             (barato, nao-reasoning, segue melhor)
OPENROUTER_MODEL=openai/gpt-4o-mini
# Opcional — aparecem no ranking do OpenRouter
OPENROUTER_APP_URL=http://localhost:8501
OPENROUTER_APP_NAME=Chef Library

# 2) OpenAI — https://platform.openai.com/api-keys
#OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#OPENAI_MODEL=gpt-4o-mini

# 3) Anthropic direto — https://console.anthropic.com/settings/keys
#ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 4) Ollama local — sem key. Instale (https://ollama.com), rode
# `ollama pull qwen2.5:7b-instruct` e suba o app (docker-compose ja mapeia
# host.docker.internal pro container alcancar o Ollama do host Mac).
# Modelos de 3B (llama3.2:3b, qwen2.5:3b) rodam mais rapido mas nao seguem
# esse prompt com confianca (ignoram o idioma pedido, classificam mal
# perguntas culinarias ambiguas) — testado nesta maquina de 8GB.
#OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
#OLLAMA_MODEL=qwen2.5:7b-instruct

# Busca web do fallback (quando o acervo nao tem nada sobre a pergunta) —
# via Tavily, funciona igual para os 4 provedores acima (diferente do
# plugin ":online", exclusivo do OpenRouter). https://tavily.com
#TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------
# Embeddings — via OpenRouter /v1/embeddings. Independente do provedor do
# agente acima: sempre precisa de OPENROUTER_API_KEY configurada, mesmo
# rodando o agente local no Ollama (o Ollama so responde perguntas, nao
# gera os embeddings usados pela busca no acervo).
# Trocado de local (sentence-transformers) para a API porque em Macs com
# pouca RAM a inferencia local levava ~4h para o acervo inteiro; a API
# entrega o mesmo em ~20min por menos de US$ 1.
# ---------------------------------------------------------------
EMBED_MODEL=openai/text-embedding-3-small
EMBED_BATCH_SIZE=500

# ---------------------------------------------------------------
# Caminhos
# ---------------------------------------------------------------
BOOKS_RAW_DIR=books
BOOKS_CLEAN_DIR=books_md
INDEX_DIR=data/index
# uploads em andamento e cache do texto extraido da aba "Adicionar livros"
INGEST_DIR=data/ingest

# Postgres da fila/historico de envios (servico "db" do docker-compose).
# No Docker o backend usa o host "db" automaticamente; DATABASE_URL so vale
# para rodar o backend ou os testes fora do Docker.
#POSTGRES_USER=chef
#POSTGRES_PASSWORD=chef
#POSTGRES_DB=chef_library
#DATABASE_URL=postgresql://chef:chef@localhost:5432/chef_library
